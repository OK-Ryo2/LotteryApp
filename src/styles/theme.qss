QMainWindow {
    background-color: #071126;
}
#centralWidget {
    /* BackgroundWidget が画面サイズに合わせてテクスチャを描画する。 */
    background-color: transparent;
}
QLabel {
    color: #F8F3E8;
    font-size: 18px;
}

/* -----------------------------
   Header(ヘッダ画像)
------------------------------ */

#titleLabel {
    font-size: 32px;
    font-weight: bold;
}

/* -----------------------------
   Panels(左、中央、右画面)
------------------------------ */

#leftPanel,
#centerPanel,
#rightPanel {
    background-color: #162438;
    border: 2px solid #D4B13F;
    border-radius: 12px;
}

#panelTitle {
    font-family: "HGS明朝B";
    font-size: 22px;
    font-weight: bold;
    color: #F6D77A;
}

/* -----------------------------
   prize card(賞品カード)
------------------------------ */

#prizeCard {
    background-color: #162438;
    border: 1px solid #162438;
    border-radius: 10px;
    padding: 10px 8px;
    min-height: 104px;
}

#prizeCardActive {
    background-color: #162438;
    border: 2px solid #E0BD4F;
    border-radius: 10px;
    min-height: 104px;
}

#rankNumber,
#rankSuffix {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    font-weight: bold;
}

#rankNumber {
    font-size: 26px;
}

#rankSuffix {
    font-size: 13px;
}

#prizeImage {
    border: none;
    background: transparent;
}

#prizeLabel {
    border: none;
    background: transparent;
    font-size: 12px;
    color: #F4F0E5;
}

#remainLabel {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    color: #FFD966;
    font-size: 16px;
}

#statusLabel {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    color: #FFD966;
    font-size: 12px;
}

#statusLabelCompleted {
    border: none;
    border-radius: 4px;
    background-color: #D2A727;
    color: #1A2B52;
    font-family: "HGS明朝B";
    font-size: 12px;
    font-weight: bold;
    padding: 6px 16px;
}

#prizeScroll {
    border: none;
    background: transparent;
    padding: 8px;
}

#prizeListContent {
    background: rgba(23, 44, 83, 180);
}

#prizeScroll QScrollBar:vertical {
    width: 10px;
    background: #0D1A35;
}

#prizeScroll QScrollBar::handle:vertical {
    background-color: #D4B13F;
    border-radius: 5px;
    min-height: 30px;
}

/* -----------------------------
   CurrentPrize（現在抽選中の賞品）
------------------------------ */
#currentPrize {
    background: transparent;
    border: none;
    min-height: 114px;
    padding: 0 18px 4px 18px;
}

#currentPrizeGoldWing,
#currentPrizeRibbon,
#currentPrizeRankNumber,
#currentPrizeRankSuffix,
#currentPrizeName,
#currentPrizeRemain {
    border: none;
    background: transparent;
}

#currentPrizeTitle {
    font-family: "HGS明朝B";
    font-size: 22px;
    font-weight: bold;
    color: #1A2B52;
    background: transparent;
    border: none;
    padding: 3;
}

#currentPrizeRankNumber,
#currentPrizeRankSuffix {
    font-family: "HGS明朝B";
    font-weight: bold;
    color: #FFD966;
}

#currentPrizeRankNumber {
    font-size: 30px;
}

#currentPrizeRankSuffix {
    font-size: 14px;
}

#currentPrizeName {
    font-family: "HGS明朝B";
    font-size: 22px;
    font-weight: bold;
    color: white;
}

#currentPrizeRemain {
    font-family: "HGS明朝B";
    font-size: 20px;
    font-weight: bold;
    color: #FFD966;
}

/* -----------------------------
   Roulette（ルーレット）
------------------------------ */
#roulette {
    background-color: #0B1533;
    border: 2px solid #D4B13F;
    border-radius: 12px;
    min-height: 186px;
}

#rouletteCandidate,
#rouletteCurrentCandidate {
    background-color: #1E3765;
    border: 1px solid #59729C;
    border-radius: 8px;
}

#rouletteCurrentCandidate {
    background-color: #C4931C;
    border: 2px solid #FFE99A;
}

#rouletteName,
#rouletteCurrentName,
#rouletteDepartment,
#rouletteCurrentDepartment {
    border: none;
    background: transparent;
}

#rouletteName {
    font-family: "HGS明朝B";
    font-size: 18px;
    color: #D9E2F2;
}

#rouletteCurrentName {
    font-family: "HGS明朝B";
    font-size: 26px;
    font-weight: bold;
    color: #17284A;
}

#rouletteDepartment {
    font-size: 12px;
    color: #AAB8D0;
}

#rouletteCurrentDepartment {
    font-size: 14px;
    color: #24375C;
}

/* -----------------------------
   抽選操作ボタン
------------------------------ */
#drawButton,
#nextPrizeButton {
    font-family: "HGS明朝B";
    font-size: 20px;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 32px;
}

#drawButton {
    color: #132347;
    background-color: #F6D463;
    border: 2px solid #B98C18;
}

#drawStatus {
    background-color: #0B1830;
    border: 1px solid #B98C18;
    border-radius: 10px;
    min-height: 50px;
    padding: 10px 16px;
}

#drawStatusLabel {
    color: #FFD966;
    background: transparent;
    border: none;
    font-family: "HGS明朝B";
    font-size: 23px;
    font-weight: bold;
}

#drawButton:hover {
    background-color: #FFE58B;
}

#drawButton:disabled {
    color: #8D99AD;
    background-color: #293750;
    border-color: #52627B;
}

#nextPrizeButton {
    color: white;
    background-color: #1A2B52;
    border: 1px solid #D3AE3B;
}

#nextPrizeButton:hover {
    background-color: #284574;
}

#nextPrizeButton:disabled {
    color: #96A3B9;
    background: #293750;
    border-color: #52627B;
}

/* -----------------------------
   Footer controls
------------------------------ */
#footerBar {
    /* 背景テクスチャをそのまま見せるため、フッター自身は透明・枠なしにする。 */
    background: transparent;
    border: none;
}

#volumeButton,
#settingsButton {
    color: #FFF9E9;
    background-color: #1A2B52;
    border: 1px solid #D3AE3B;
    border-radius: 6px;
    font-family: "HGS明朝B";
    font-size: 15px;
    font-weight: bold;
    padding: 4px 12px;
}

#volumeButton:hover,
#settingsButton:hover {
    background-color: #284574;
}

#footerMessage {
    color: #F6D77A;
    font-family: "HGS明朝B";
    font-size: 16px;
    font-weight: bold;
}

#winnerDialog,
#settingsDialog {
    background-color: #071126;
    border: 2px solid #D4B13F;
    border-radius: 12px;
    padding: 28px 32px 24px 32px;
}

#winnerDialogConfetti {
    background: transparent;
    border: none;
}

#winnerDialogContent {
    background: transparent;
    border: none;
}

#winnerDialogStatus {
    color: #FFFFFF;
    font-family: "HGS明朝B";
    font-size: 52px;
    font-weight: bold;
}

#winnerDialogDepartment,
#settingsDialogMessage {
    color: #D9E2F2;
    font-family: "HGS明朝B";
    font-size: 36px;
}

#winnerDialogName {
    color: #FFF9E9;
    font-family: "HGS明朝B";
    font-size: 72px;
    font-weight: bold;
}

#winnerDialogClose,
#settingsDialogReload,
#settingsDialogClose,
#settingsDialogST {
    color: #17284A;
    background-color: #F6D463;
    border: 1px solid #B98C18;
    border-radius: 6px;
    font-family: "HGS明朝B";
    font-size: 16px;
    font-weight: bold;
    padding: 5px 20px;
}

#prizeRevealDialog {
    background-color: #162438;
    border: 2px solid #D4B13F;
    border-radius: 14px;
    padding: 10px 34px 14px 34px;
}

#prizeRevealTitle,
#prizeRevealRank,
#prizeRevealName,
#prizeRevealDescription,
#prizeRevealRibbon {
    background: transparent;
    border: none;
}

#prizeRevealTitle {
    color: #FFD966;
    font-family: "HGS明朝B";
    font-size: 28px;
    min-height: 36px;
    max-height: 36px;
    font-weight: bold;
}

#prizeRevealRank {
    color: #F6D77A;
    font-family: "HGS明朝B";
    font-size: 34px;
    min-height: 44px;
    max-height: 44px;
    font-weight: bold;
}

#prizeRevealName {
    color: #FFF9E9;
    font-family: "HGS明朝B";
    font-size: 27px;
    min-height: 42px;
    max-height: 42px;
    font-weight: bold;
}

#prizeRevealImage {
    background: transparent;
    border: none;
    color: #D9E2F2;
}

#prizeRevealDescription {
    color: #D9E2F2;
    font-size: 16px;
    min-height: 34px;
    max-height: 34px;
}

#prizeRevealStartButton,
#prizeRevealCancelButton {
    font-family: "HGS明朝B";
    font-size: 17px;
    font-weight: bold;
    border-radius: 6px;
    padding: 7px 22px;
}

#prizeRevealStartButton {
    color: #17284A;
    background-color: #F6D463;
    border: 1px solid #B98C18;
}

#prizeRevealCancelButton {
    color: #FFF9E9;
    background: #284574;
    border: 1px solid #D3AE3B;
}

/* -----------------------------
   HistoryList（当選履歴）
------------------------------ */
#historyList {
    background-color: #162438;
    border: 1px solid #60739A;
    border-radius: 8px;
    padding: 8px;
}

#historyScroll {
    background: transparent;
    border: none;
}

#historyCard {
    background-color: #162438;
    border: none;
    border-bottom: 1px solid #40547A;
    min-height: 74px;
    max-height: 74px;
    padding: 8px 12px;
}

#historyPrize,
#historyDepartment,
#historyWinner,
#historyTime {
    border: none;
    background: transparent;
}

#historyPrize {
    font-family: "HGS明朝B";
    font-size: 15px;
    font-weight: bold;
    color: #FFD966;
}

#historyWinner {
    font-family: "HGS明朝B";
    font-size: 22px;
    color: #FFF9E9;
}

#historyDepartment {
    font-family: "HGS明朝B";
    font-size: 14px;
    color: #AAB8D0;
}

#historyTime {
    font-size: 13px;
    color: #AAB8D0;
}

/* -----------------------------
   ParticipantCount（参加人数）
------------------------------ */
#participantCount {
    background-color: #27334a;
    border: 2px solid #D4B13F;
    border-radius: 10px;
    min-width: 118px;
    min-height: 60px;
    padding: 5px 6px;
}

#participantTitle {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    font-size: 17px;
    font-weight: bold;
    color: #FFF9E9;
}

#participantNumber {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    font-size: 26px;
    font-weight: bold;
    color: #FFD966;
}

#participantUnit {
    border: none;
    background: transparent;
    font-family: "HGS明朝B";
    font-size: 17px;
    color: white;
}
